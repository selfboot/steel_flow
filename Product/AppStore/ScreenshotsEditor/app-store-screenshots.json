        "headline": {
          "en-US": "Export polished PDF\nand CSV files.",
          "zh-Hans": "导出专业 PDF\n与 CSV 清单。"
        },
        "screenshot": "/screenshots/apple/iphone/{locale}/calculator.png",
        "inverted": true
      },
      {
        "id": "steelflow-offline",
        "layout": "device-bottom",
        "label": {
          "en-US": "PRIVATE BY DEFAULT",
          "zh-Hans": "默认保护隐私"
        },
        "headline": {
          "en-US": "Works offline.\nNo account required.",
          "zh-Hans": "离线可用，\n无需注册账号。"
        },
        "screenshot": "/screenshots/apple/iphone/{locale}/calculator.png"
      }
    ],
    "android": [],
