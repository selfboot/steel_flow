{
  "schemaVersion": 2,
  "appName": "SteelFlow",
  "themeId": "ocean-fresh",
  "connectedCanvas": false,
  "locales": [
    "en-US",
    "zh-Hans"
  ],
  "locale": "zh-Hans",
  "device": "iphone",
  "orientation": "portrait",
  "appIcon": "/brand/app-icon.png",
  "slidesByDevice": {
    "iphone": [
      {
        "id": "steelflow-cover",
        "layout": "hero",
